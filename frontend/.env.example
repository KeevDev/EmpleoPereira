# ---------------------------------------------------------------------------
# Variables del front. Copia a .env.local para desarrollo:
#
#   cp .env.example .env.local
#
# En Vercel se configuran en Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# URL pública de la API Laravel, sin barra final.
#
# En desarrollo, apuntando al docker-compose del backend:
#   NEXT_PUBLIC_API_URL=http://localhost:8090
#
# En producción. El dominio del front debe estar además en
# CORS_ALLOWED_ORIGINS del backend, o el navegador bloqueará las llamadas.
NEXT_PUBLIC_API_URL=https://empleo-pereira-api.operyxapp.com
